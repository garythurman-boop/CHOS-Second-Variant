-	dir->d_ent.d_type = DT_DIR;
-    else if (dir->fdata.dwFileAttributes == FILE_ATTRIBUTE_NORMAL)
-	dir->d_ent.d_type = DT_REG;
-    else
-	dir->d_ent.d_type = DT_UNKNOWN;
-
-    if (!FindNextFile (dir->handle, &dir->fdata))

+#if BOS(CHOS)
+// Use the OS-owned entropy service directly. No local generator, time seed or
+// plaintext device fallback. This void API must fail closed on unavailability.
+void cryptoRandom(void* buffer, size_t length)
+{
+    auto* cursor = static_cast<unsigned char*>(buffer);
+    unsigned retries = 0;
+    while (length) {
+        size_t request = length < CHOS_SYS_MAX_RANDOM_BYTES ? length : CHOS_SYS_MAX_RANDOM_BYTES;
+        long count = chos_random_bytes(cursor, request);
+        if (count > 0 && static_cast<size_t>(count) <= request) {
+            cursor += count;
+            length -= static_cast<size_t>(count);
+            continue;
+        }
+        if ((count == -CHOS_ERRNO_EAGAIN || count == -CHOS_ERRNO_EINTR) && retries++ < 32) {
+            if (!chos_sleep_ticks(1))
+                continue;
+        }
+        BCRASH();
+    }
+}

+#elif OS(CHOS)
+    auto ts = checkedNativeClock(CLOCK_MONOTONIC);
+    return fromRawSeconds(static_cast<double>(ts.tv_sec) + ts.tv_nsec / 1e9);
 #elif OS(LINUX) || OS(FREEBSD) || OS(OPENBSD) || OS(NETBSD)

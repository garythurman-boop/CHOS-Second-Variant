+    count = snprintf(message, sizeof(message), "%s(%d) : %s\n", file, line, function);
+    nativeFormattedLog(message, count, sizeof(message));
+#else
     vfprintf(stderr, format, args);
     va_end(args);
     fprintf(stderr, "%s(%d) : %s\n", file, line, function);
+#endif
 }
 #endif


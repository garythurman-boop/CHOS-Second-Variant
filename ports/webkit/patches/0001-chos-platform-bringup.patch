 namespace WTF {

+#if OS(CHOS)
+// The native API reports unavailable/denied clocks. This infallible engine API
+// must fail closed rather than return a fabricated epoch or mutable fallback.
+static timespec checkedNativeClock(clockid_t clock)
+{
+    timespec result;
+    RELEASE_ASSERT(!clock_gettime(clock, &result));
+    return result;
+}
+#endif
+
 #if OS(WINDOWS)

 // Number of 100 nanosecond between January 1, 1601 and January 1, 1970.
@@ -213,15 +224,23 @@ double currentTime()

 Int128 currentTimeInNanoseconds()
 {
+#if OS(CHOS)
+    auto ts = checkedNativeClock(CLOCK_REALTIME);
+#else
     struct timespec ts { };
     clock_gettime(CLOCK_REALTIME, &ts);
+#endif
     return (static_cast<Int128>(ts.tv_sec) * 1'000'000'000) + ts.tv_nsec;
 }

 static inline double currentTime()
 {
+#if OS(CHOS)
+    auto ts = checkedNativeClock(CLOCK_REALTIME);
+#else
     struct timespec ts { };
     clock_gettime(CLOCK_REALTIME, &ts);
+#endif
     return static_cast<double>(ts.tv_sec) + ts.tv_nsec / 1'000'000'000.0;
 }


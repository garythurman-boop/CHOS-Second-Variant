@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/ZLIBTargets.cmake")
set(ZLIB_VERSION "@PROJECT_VERSION@")
set(ZLIB_VERSION_STRING "@PROJECT_VERSION@")
set(ZLIB_LIBRARIES ZLIB::ZLIB)
set_and_check(ZLIB_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include")
# This package intentionally supplies no gzFile/filesystem API. It retains
# default allocators, compression utilities, and raw/zlib/gzip memory streams.
set(CHOS_ZLIB_MEMORY_API TRUE)
check_required_components(ZLIB)

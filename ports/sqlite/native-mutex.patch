--- a/sqlite3.c
+++ b/sqlite3.c
@@ -18602,7 +18602,7 @@
 #if !SQLITE_THREADSAFE
 # define SQLITE_MUTEX_OMIT
 #endif
-#if SQLITE_THREADSAFE && !defined(SQLITE_MUTEX_NOOP)
+#if SQLITE_THREADSAFE && !defined(SQLITE_MUTEX_NOOP) && !defined(SQLITE_MUTEX_CHOS)
 #  if SQLITE_OS_UNIX || defined(__CYGWIN__)

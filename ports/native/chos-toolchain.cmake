# Real executable links against the native CRT and checked static runtime.
# CHOS_SDK_ROOT must name a staged SDK produced by make native-sdk.
if(NOT DEFINED CHOS_SDK_ROOT)
  if(DEFINED ENV{CHOS_SDK_ROOT})
    set(CHOS_SDK_ROOT "$ENV{CHOS_SDK_ROOT}")
  else()
    message(FATAL_ERROR "Set CHOS_SDK_ROOT to a staged native SDK")
  endif()
endif()
get_filename_component(CHOS_SDK_ROOT "${CHOS_SDK_ROOT}" ABSOLUTE)
if(NOT EXISTS "${CHOS_SDK_ROOT}/chos-sdk.json")
  message(FATAL_ERROR "Missing native SDK manifest: ${CHOS_SDK_ROOT}")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CHOS_SDK_ROOT)
get_filename_component(CHOS_PORT_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
list(PREPEND CMAKE_MODULE_PATH "${CHOS_PORT_ROOT}/webkit/cmake")
set(CMAKE_SYSTEM_NAME CHOS)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_ASM_COMPILER clang)
set(CMAKE_ASM_COMPILER_TARGET aarch64-none-elf)
set(CMAKE_ASM_FLAGS_INIT "--target=aarch64-none-elf -mcpu=cortex-a72")
set(CMAKE_C_COMPILER_TARGET aarch64-none-elf)
set(CMAKE_CXX_COMPILER_TARGET aarch64-none-elf)
set(CMAKE_AR llvm-ar)
set(CMAKE_RANLIB llvm-ranlib)
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
set(CMAKE_SYSROOT "${CHOS_SDK_ROOT}")
set(CHOS_LANGUAGE_FLAGS "-D__CHOS__=1 -fhosted -fno-builtin -fno-stack-protector -fno-pic -fno-pie -femulated-tls -ffunction-sections -fdata-sections -mcpu=cortex-a72 -mstrict-align")
# -fhosted supplies the language's ordinary main linkage/implicit return rules;
# it is not a claim that every hosted C/C++ library API has been implemented.
set(CMAKE_C_FLAGS_INIT "${CHOS_LANGUAGE_FLAGS} -isystem \"${CHOS_SDK_ROOT}/include\"")
set(CMAKE_CXX_FLAGS_INIT "${CHOS_LANGUAGE_FLAGS} -fno-exceptions -fno-rtti -nostdinc++ -isystem \"${CHOS_SDK_ROOT}/include/c++/v1\" -isystem \"${CHOS_SDK_ROOT}/include\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-nostdlib -static -fuse-ld=lld -Wl,-T,\"${CHOS_SDK_ROOT}/lib/app.ld\" -Wl,--gc-sections -Wl,-z,max-page-size=4096 \"${CHOS_SDK_ROOT}/lib/crt0.o\" \"${CHOS_SDK_ROOT}/lib/crtinit.o\" \"${CHOS_SDK_ROOT}/lib/chos-abi.o\"")
set(CHOS_RUNTIME_LIBRARIES "-Wl,--start-group \"${CHOS_SDK_ROOT}/lib/libchos-c++.a\" \"${CHOS_SDK_ROOT}/lib/libchos-m.a\" \"${CHOS_SDK_ROOT}/lib/libchos-quad.a\" \"${CHOS_SDK_ROOT}/lib/libchos-complex.a\" \"${CHOS_SDK_ROOT}/lib/libchos-wide.a\" \"${CHOS_SDK_ROOT}/lib/libchos-stdio.a\" \"${CHOS_SDK_ROOT}/lib/libchos-format.a\" \"${CHOS_SDK_ROOT}/lib/libchos-floatparse.a\" \"${CHOS_SDK_ROOT}/lib/libchos-c.a\" -Wl,--end-group")
set(CMAKE_C_STANDARD_LIBRARIES "${CHOS_RUNTIME_LIBRARIES}")
set(CMAKE_CXX_STANDARD_LIBRARIES "${CHOS_RUNTIME_LIBRARIES}")
set(CMAKE_FIND_ROOT_PATH "${CHOS_SDK_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CHOS_SDK_ROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CHOS_SDK_ROOT}/lib/pkgconfig:${CHOS_SDK_ROOT}/share/pkgconfig")
set(ENV{PKG_CONFIG_PATH} "")

# Source archives omit versioned binary publications; GitHub retains the assets.
/artifacts export-ignore
# Keep the dependency byte-identical to its pinned upstream inventory.
/third_party/lwip/** -whitespace

third_party/mbedtls/** -whitespace
# Preserve original ICU dependency whitespace and its verified upstream hashes.
/third_party/icu-threading/** -whitespace
/third_party/icu-normalization-data/** -whitespace
/third_party/icu-data-source/** -whitespace
# Keep the selected Test262 scripts and original harness byte-identical.
/third_party/test262-subset/** -whitespace

# Preserve exact pinned upstream font implementation and fixture bytes.
/third_party/freetype/** -whitespace
/third_party/harfbuzz/** -whitespace
/third_party/text-fixtures/** -whitespace
# Preserve exact original software graphics sources and licenses.
/third_party/cairo/** -whitespace
/third_party/pixman/** -whitespace
/ports/graphics/*.patch -whitespace
# Original NEWS uses seven '=' signs as historical date underlines.
/third_party/cairo/NEWS conflict-marker-size=32
